+    public func lookupInstalledApp(bundleID: String) async throws -> InstalledAppMetadata? {
+        try await withFFIDispatch {
+            try self.verifyInitialized()
+            return try self.performWithEitherService(
+                connectRP: installation_proxy_connect_rsd,
+                connectLockdown: installation_proxy_connect,
+                cleanup: installation_proxy_client_free,
+                serviceName: "instproxy"
+            ) { client in
+                var result: UnsafeMutableRawPointer?
+                var count = 0
+                let error = bundleID.withCString { identifier in
+                    var identifiers: [UnsafePointer<Int8>?] = [identifier]
+                    return installation_proxy_get_apps(client, nil, &identifiers, 1, &result, &count)
+                }
+                if let error {
+                    defer { idevice_error_free(error) }
+                    throw IdeviceGatewayError(.serviceError, reason: "Installed app lookup failed")
+                }
+                guard count > 0 else { return nil }
+                guard let result else {
+                    throw IdeviceGatewayError(.serviceError, reason: "Installed app lookup returned no metadata")
+                }
+                let entries = result.assumingMemoryBound(to: plist_t?.self)
+                defer {
+                    for index in 0..<count {
+                        if let entry = entries[index] { plist_free(entry) }
+                    }
+                    free(result)
+                }
+                guard count == 1, let app = entries[0] else {
+                    throw IdeviceGatewayError(.serviceError, reason: "Installed app lookup returned ambiguous metadata")
+                }
+                func string(_ key: String, in dictionary: plist_t) -> String? {
+                    guard let value = plist_dict_get_item(dictionary, key) else { return nil }
+                    return self.getRustPlistString(value)
+                }
+                let entitlements = plist_dict_get_item(app, "Entitlements")
+                return InstalledAppMetadata(
+                    bundleID: string("CFBundleIdentifier", in: app) ?? bundleID,
+                    applicationID: entitlements.flatMap { string("application-identifier", in: $0) }
+                        ?? string("ApplicationIdentifier", in: app),
+                    teamID: entitlements.flatMap { string("com.apple.developer.team-identifier", in: $0) }
+                        ?? string("TeamIdentifier", in: app),
+                    build: string("CFBundleVersion", in: app)
+                )
+            }
+        }
+    }
